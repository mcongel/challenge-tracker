# Scripts only (seed/snapshot/backup/restore) — service role key, NEVER in the
# browser, never committed, never in a file a build tool reads. Copy these two
# lines to .env.scripts (gitignored) and load them into the shell before
# running a script:
#   PowerShell:  Get-Content .env.scripts | ForEach-Object { $n,$v = $_ -split '=',2; if ($n -notmatch '^#') { Set-Item "env:$n" $v } }
#   bash:        set -a; . ./.env.scripts; set +a
SUPABASE_URL=https://mlvntnbgboinjhmavwao.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
