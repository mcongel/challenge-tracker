{
  "name": "challenge-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "seed": "node scripts/seed.mjs",
    "snapshot": "tsx scripts/daily-snapshot.ts",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.12",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
